			header X-Backup-Registry "https://macrophage.primals.eco/"
			header X-Compliance-Audit "https://complement.primals.eco/"
			header X-Detection-Matrix "https://receptor.primals.eco/"
		}
	}

	# -- Epitope concept redirects --
	@is_metrictensor host metric-tensor.primals.eco
	redir @is_metrictensor https://tuebor.primals.eco/analysis/metric-tensor/ permanent

	@is_scyborg host scyborg.primals.eco license.primals.eco
