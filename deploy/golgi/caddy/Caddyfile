# ── Möbius: live JSON feeds ──────────────────────────────────────────
# One door. New *.json in live-terminal appears without a new handle.
# Cost is sigmoid (constant per site), not exponential in feed count.
# Unique pores (reverse_proxy, special CORS, html) stay explicit.
(live_json) {
	@livejson {
		path *.json
		not path /neutron-burst.json
		not path /crush-mix.json
		not path /sourdough-leaven.json
		not path /manifest.json
		not path /presence.json
		not path /tower.json
	}
	handle @livejson {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-cache, must-revalidate"
		header Access-Control-Allow-Origin "*"
		root * /opt/membrane/live-terminal
		file_server
	}
}

