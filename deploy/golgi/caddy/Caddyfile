	# ═══ Trail breadcrumb — the one real link in the maze ═══
	# On every wildcard subdomain, /trail leads to the real membrane.
	# Bots won't find it (they spider from the scatter-generated index).
	# Humans notice the pattern: there's always a trail.
	handle /trail {
		redir https://hud.primals.eco/trail permanent
	}
	handle /humans.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond "# if you're reading this, you're probably human.
# the fleet doesn't check humans.txt.
# 
# follow the trail: https://hud.primals.eco/trail
# or just go to: https://hud.primals.eco
#
# no cookies. no tracking. no IP addresses stored.
# the data is the data. we are reporting it.
" 200
	}

	# HUMAN PASSTHROUGH — unknown subdomains serve Forgejo explore for humans
	@wildcard_human {
		not header User-Agent *bot*
		not header User-Agent *Bot*
		not header User-Agent *crawler*
		not header User-Agent *spider*
		not header User-Agent *Crawler*
		not header User-Agent *Spider*
		not header User-Agent *Scrapy*
		not header User-Agent *python*
		not header User-Agent *Go-http-client*
		not header User-Agent *Java*
		not header User-Agent *axios*
		not header User-Agent *node-fetch*
	}
	handle @wildcard_human {
		reverse_proxy 10.13.37.5:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Default: remaining traffic (bots without known UA) -> scatter
	handle {
		reverse_proxy localhost:9753 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Declared-Lang {>Accept-Language}
			header_up X-Declared-Sec {>Sec-Fetch-Mode}
		}
	}
}

# = NEUTRON — membrane mail =
neutron.primals.eco {
  tls {
    issuer acme {
      email membrane@primals.eco
    }
  }
  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Content-Security-Policy "default-src 'self' 'unsafe-inline'; connect-src 'self' https://notify.primals.eco"
  }
	# inter-gate message relay
	handle /api/gate-msg* {
		reverse_proxy 127.0.0.1:9761 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
  handle /api/discuss* {
    reverse_proxy 127.0.0.1:8097
  }
  handle {
    root * /opt/ecoPrimals/hud/site/public/neutron
    file_server
  }
  log {
    output file /var/log/caddy/access.log
    format json
  }
}

