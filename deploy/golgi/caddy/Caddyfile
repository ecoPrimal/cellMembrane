# ═══ SENSITIVE PATH BLOCKING — 404 dotfiles, admin, backup paths ═══
(block_sensitive_paths) {
	@dotfiles path /.env /.env.* /.git /.git/* /.gitignore /.htaccess /.DS_Store /.ssh/* /.npmrc /.dockerignore
	handle @dotfiles {
		respond 404
	}
	@admin_paths path /wp-admin /wp-admin/* /wp-login* /wp-content* /admin /admin/* /phpmyadmin* /xmlrpc.php /server-status /server-info
	handle @admin_paths {
		respond 404
	}
	@build_files path /composer.json /package.json /Dockerfile /docker-compose* /Thumbs.db /backup* /.backup* /id_rsa*
	handle @build_files {
		respond 404
	}
}

